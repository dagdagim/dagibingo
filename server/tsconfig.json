{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@bingo/shared": ["./src/shared/index", "../packages/shared/src/index"],
      "@bingo/shared/*": ["./src/shared/*", "../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
